graph TD
    starting --> planning
    planning --> implementing
    implementing --> checking
    checking --> reporting

classDef done fill:#dcfce7,stroke:#15803d,stroke-width:2px;
classDef active fill:#dbeafe,stroke:#2563eb,stroke-width:3px;
classDef failed fill:#fee2e2,stroke:#b42318,stroke-width:2px;
class implementing failed;
class planning done;
class starting done;
class reporting failed;
class checking done;
