---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	orientation(orientation)
	planner(planner)
	implementor(implementor)
	checker(checker)
	reviewer(reviewer)
	reporter(reporter)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> orientation;
	__start__ -.-> planner;
	checker -.-> implementor;
	checker -.-> reporter;
	checker -.-> reviewer;
	implementor -.-> checker;
	orientation --> planner;
	planner --> implementor;
	reviewer -.-> implementor;
	reviewer -.-> reporter;
	reporter --> __end__;
	implementor -.-> implementor;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

classDef done fill:#dcfce7,stroke:#15803d,stroke-width:2px;
classDef active fill:#dbeafe,stroke:#2563eb,stroke-width:3px;
classDef failed fill:#fee2e2,stroke:#b42318,stroke-width:2px;
class implementor done;
class planner done;
class __start__ done;
